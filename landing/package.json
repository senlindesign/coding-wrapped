{
  "name": "landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "deploy": "wrangler deploy",
    "deploy:check": "npm test && wrangler deploy --dry-run",
    "preview": "vite preview",
    "test": "npm run build && node --test tests/content.test.mjs tests/sites-worker.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "cuelume": "^0.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "^6.4.3",
    "wrangler": "^4.120.0"
  }
}
