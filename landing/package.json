{
  "name": "landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "deploy": "wrangler deploy",
    "deploy:check": "npm test && wrangler deploy --dry-run",
    "preview": "vite preview",
    "test": "npm run build && node --test tests/content.test.mjs tests/sites-worker.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.94.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2",
    "wrangler": "^4.119.0"
  }
}
